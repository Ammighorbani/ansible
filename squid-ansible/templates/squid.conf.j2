# Squid configuration generated by Ansible
# Do not edit this file manually.
# Source of truth: default/group_vars.yml

visible_hostname {{ squid_hostname }}

# -------------------------------------------------
# Listener configuration
# -------------------------------------------------

# Listen on all IPv4 interfaces
http_port {{ squid_http_port }}

# -------------------------------------------------
# Client access ACLs
# -------------------------------------------------

# Allowed client IP addresses
# The /32 suffix is added automatically.
{% for client_ip in allow_ips %}
acl k8s_node_{{ loop.index }} src {{ client_ip }}/32
{% endfor %}

# Allow the local machine to use the proxy
acl localhost src 127.0.0.1/32
acl localhost src ::1

# -------------------------------------------------
# Destination port ACLs
# -------------------------------------------------

# HTTPS destination port
acl SSL_ports port 443

# Allowed destination ports
acl Safe_ports port 80
acl Safe_ports port 443
acl Safe_ports port 1024-65535

# HTTP CONNECT method
acl CONNECT method CONNECT

# -------------------------------------------------
# Security rules
# Rule order is important.
# -------------------------------------------------

# Never allow access to unsafe destination ports
http_access deny !Safe_ports

# CONNECT is permitted only for TLS/HTTPS
http_access deny CONNECT !SSL_ports

# Permit localhost
http_access allow localhost

# Permit configured client IP addresses
{% for client_ip in allow_ips %}
http_access allow k8s_node_{{ loop.index }}
{% endfor %}

# Block every other client
http_access deny all

# -------------------------------------------------
# DNS configuration
# -------------------------------------------------

dns_nameservers{% for dns_server in squid_dns_nameservers %} {{ dns_server }}{% endfor %}

# -------------------------------------------------
# Cache configuration
# -------------------------------------------------

cache_mem {{ squid_cache_mem }}
maximum_object_size {{ squid_maximum_object_size }}

cache_dir {{ squid_cache_dir_type }} \
{{ squid_cache_dir_path }} \
{{ squid_cache_size_mb }} \
{{ squid_cache_level_1_dirs }} \
{{ squid_cache_level_2_dirs }}

# -------------------------------------------------
# Logging configuration
# -------------------------------------------------

access_log stdio:{{ squid_access_log }} squid
cache_log {{ squid_cache_log }}

# -------------------------------------------------
# Privacy configuration
# -------------------------------------------------

forwarded_for {{ squid_forwarded_for }}
via {{ squid_via }}

request_header_access X-Forwarded-For deny all
request_header_access Via deny all

# -------------------------------------------------
# Refresh patterns
# -------------------------------------------------

refresh_pattern ^ftp: 1440 20% 10080
refresh_pattern ^gopher: 1440 0% 1440
refresh_pattern -i (/cgi-bin/|\?) 0 0% 0
refresh_pattern . 0 20% 4320

# -------------------------------------------------
# Outbound source IP
# -------------------------------------------------

# This IP must exist on the Squid host
# or be available through provider-level routing.
tcp_outgoing_address {{ outgoing_ip }}
