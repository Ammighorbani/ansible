# GitLab Container Configuration
gitlab_image_tag=latest
gitlab_container_name=gitlab-server
gitlab_runner_image_tag=latest
gitlab_runner_container_name=gitlab-runner

# Domain and Ports
domain_name={{ domain_name }}
external_sub={{ gitlab_sub_http_srvn }}
registry_external_sub={{ gitlab_sub_container_registry_srvn }}
registry_port={{ 5050 }}
gitlab_internal_port={{ 80 }}

# Network & Volumes Prefix
network_name={{ network_name }}
