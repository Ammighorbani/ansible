version: '3.8'

networks:
  web_net:
    external: true
    name: ${network_name:-web_net}

services:
  nginx:
    image: nginx:${nginx_image_tag:-alpine}
    container_name: ${nginx_container_name:-nginx-proxy}
    restart: always
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - web_net
