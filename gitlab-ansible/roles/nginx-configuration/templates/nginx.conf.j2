# 1. GitLab Web UI & Git HTTP
server {
    listen 80;
    server_name {{ gitlab_sub_http_srvn }}.{{ domain_name }};

    # Prevent HTTP 413 error when pushing large Git objects
    client_max_body_size 0;

    # Disable buffering for real-time operations and CI log streaming
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://gitlab-server:80;
        
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for GitLab live logs
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }
}

# 2. GitLab Container Registry
server {
    listen 80;
    server_name {{ gitlab_sub_container_registry_srvn }}.{{ domain_name }};

    # Unlimited body size for pushing heavy Docker image layers
    client_max_body_size 0;

    # Required settings for Docker registry client
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://gitlab-server:5050;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 900s;
    }
}
