$TTL    86400
@       IN      SOA     ns1.{{ dns_zone_name }}. admin.{{ dns_zone_name }}. (
                        {{ dns_zone_serial }} ; Serial
                        3600                  ; Refresh
                        1800                  ; Retry
                        604800                ; Expire
                        86400                 ; Minimum TTL
)

@       IN      NS      ns1.{{ dns_zone_name }}.
ns1     IN      A       {{ dns_server_ip }}

{% for record in dns_records %}
{{ record.name }}    IN    {{ record.type }}    {{ record.value }}
{% endfor %}
